# Connect6 PolicyBuddy POC (frontend-only: skips Supabase login/chat persistence)
# NEXT_PUBLIC_CONNECT6_POC_MODE=true
# NEXT_PUBLIC_CONNECT6_POC_WORKSPACE_ID=connect6-poc

# Encrypted REST + WS (PolicyBuddy cloud — keys come from Bay6, NOT the Postman localhost sample):
# NEXT_PUBLIC_CONNECT6_BAY6_ENCRYPT=true
# NEXT_PUBLIC_CONNECT6_HTTP_BASE=https://connect6-api.bay6.ai
#
# Dev gateway (example):
# NEXT_PUBLIC_CONNECT6_HTTP_BASE=https://connect6dev.bay6.ai
# NEXT_PUBLIC_CONNECT6_BAY6_ENCRYPT=false
#
# Local Postman-style stack:
# NEXT_PUBLIC_CONNECT6_HTTP_BASE=http://localhost:4000

# Connect6 — REST + WS token flow uses Next.js API proxies (/api/connect6/*).
# Prefer server-only keys (not shipped to the browser):
# CONNECT6_HTTP_BASE=https://connect6dev.bay6.ai
# CONNECT6_ACCESS_KEY=
# CONNECT6_SECRET_KEY=
# CONNECT6_CLIENT_ID=24
# Or expose to client bundle (restart dev after change):
# NEXT_PUBLIC_CONNECT6_HTTP_BASE=https://connect6dev.bay6.ai
# NEXT_PUBLIC_CONNECT6_WS_BASE=wss://connect6-proapi.bay6.ai
# NEXT_PUBLIC_CONNECT6_ACCESS_KEY=
# NEXT_PUBLIC_CONNECT6_SECRET_KEY=
# NEXT_PUBLIC_CONNECT6_CLIENT_CODE=POLICYBUDDY
# NEXT_PUBLIC_CONNECT6_CLIENT_ID=24